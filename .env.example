# Copy to .env and fill in for production. Everything except SESSION_SECRET is optional.

# --- Server ---
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Public origin of the deployed app (used for CORS and the default OIDC redirect URI).
PUBLIC_URL=https://knit.example.com
# Requests per minute per IP on /api endpoints.
RATE_LIMIT_MAX=60
# Directory of the built frontend to serve (set automatically in the Docker image).
#STATIC_ROOT=/app/apps/web/dist

# --- Sessions (REQUIRED in production; >= 32 random chars) ---
# e.g. `openssl rand -hex 32` or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=

# --- Single sign-on (optional; any standard OIDC provider) ---
# Google:            https://accounts.google.com
# Microsoft Entra:   https://login.microsoftonline.com/<tenant>/v2.0
# Okta / Auth0 / Keycloak: your issuer URL
#OIDC_ISSUER=https://accounts.google.com
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
# Defaults to ${PUBLIC_URL}/api/auth/callback — register this with your provider.
#OIDC_REDIRECT_URI=

# Require sign-in for pattern generation/export (needs OIDC configured).
AUTH_REQUIRED=false

# --- Storage ---
# Where the SQLite database (accounts + saved patterns) lives. In Docker, mount a volume here.
DATA_DIR=./data

# --- Stripe (integration points prepared, not yet wired) ---
# The accounts table already carries `plan` and `stripe_customer_id`; see README
# "Stripe integration points" for exactly where a checkout/webhook implementation plugs in.
#STRIPE_SECRET_KEY=
#STRIPE_WEBHOOK_SECRET=
#STRIPE_PRICE_ID=
